    {
      "id": "e756242f-609c-448c-8f86-f05d3c9f9677",
      "title": "Jaipur Wedding Photography Portfolio",
      "description": "A single-page showcase for a wedding photographer based in Jaipur, highlighting style, services, and a warm invitation to connect.",
      "slug": "",
      "theme": {
        "background": "#FAFAFA",
        "surface": "#FFFFFF",
        "text": "#333333",
        "accent": "#8B0000",
        "font": "sans"
      },
      "blocks": [
        {
          "id": "57d62ae9-d1f1-4247-b1a9-b10cf7739f39",
          "type": "eyebrow",
          "text": "Wedding Photography"
        },
        {
          "id": "e8f3c9f9-e3f3-4819-81f9-c2138c6f9a8e",
          "type": "heading",
          "text": "Capturing Jaipur’s Eternal Vows"
        },
        {
          "id": "817824aa-cf94-45e1-b1dd-73d557bfa6aa",
          "type": "text",
          "text": "From the rose‑laden courtyards to the golden sands of the desert, I frame each love story with a blend of tradition and modern flair. Let’s turn your wedding day into a visual legacy that lives beyond the album."
        },
        {
          "id": "b010d311-886d-4130-9c15-4b354d72e3bc",
          "type": "image",
          "text": "Bride in a Jaipur palace backdrop",
          "url": ""
        },
        {
          "id": "3fd6ddd7-ae1e-4019-86ca-a22a184cd3e7",
          "type": "text",
          "text": "My approach combines candid moments with elegant portraits, offering full‑day coverage, pre‑wedding shoots, and a curated collection of high‑resolution edits."
        },
        {
          "id": "6cdb6a9e-a210-4eea-bf53-ce1985363c72",
          "type": "image",
          "text": "Sunset ceremony at Amber Fort",
          "url": ""
        },
        {
          "id": "75c7ef2e-f274-4467-b0bf-3124a488b4bc",
          "type": "text",
          "text": "I work closely with you to understand your cultural nuances, ensuring every ritual—from the baraat to the vidaai—is photographed with respect and artistry."
        },
        {
          "id": "97e6cdec-36ec-4295-9b30-12ca7673d8b7",
          "type": "form",
          "text": "Ready to start planning? Drop your details below and I’ll get back to you within 24 hours.",
          "buttonText": "Submit"
        },
        {
          "id": "e6a014d4-851e-4a1f-be98-8fb920f540ec",
          "type": "button",
          "text": "Book a Consultation",
          "url": "#contact"
        }
      ],
      "updatedAt": "2026-11-25T19:59:28.933Z",
      "publishedAt": null
    },
